{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visuales",
  "version": "2.0.8",
  "identifier": "cu.uclv.visuales.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run sidecar:prepare && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run sidecar:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Visuales", "width": 1240, "height": 820, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBN0Y3Q0JFNkYyMzI5QUQKUldTdEtTTnZ2bngvcWp0MklXUEFFV1dkZ2t0NjVPQzh4MEM0TGFxbDhFTEdhWGlhbG9rdldSREYK",
      "endpoints": ["https://github.com/Carlos-err406/visuales-search/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "macOS": { "minimumSystemVersion": "13.5", "signingIdentity": "-", "entitlements": "Entitlements.plist" },
    "targets": "all",
    "externalBin": ["binaries/visuales-node"],
    "resources": ["resources/sidecar.cjs", "resources/runtime.json", "resources/NODE-LICENSE.txt"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
