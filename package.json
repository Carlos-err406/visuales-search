{
  "name": "visuales",
  "version": "1.0.0",
  "description": "Search tool for visuales.uclv.cu content",
  "main": "cli.ts",
  "bin": {
    "visuales": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow npm",
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": "prettier --write",
    "*.{ts,js}": "eslint --fix"
  },
  "keywords": [
    "search",
    "cli",
    "visuales",
    "uclv"
  ],
  "author": "",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1",
    "@types/cli-progress": "^3.11.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cheerio": "^1.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "inquirer": "^13.1.0",
    "node-downloader-helper": "^2.1.10",
    "p-limit": "^7.2.0"
  }
}
