{
  "name": "visuales",
  "version": "1.3.7",
  "description": "Search and download visuales.uclv.cu content from the terminal",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "visuales": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && node --test 'test/**/*.test.mjs'",
    "check": "npm run lint && npm test",
    "release:check": "npm run check && npm pack --dry-run --cache .cache/npm",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "prepare": "node scripts/prepare.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "postbuild": "chmod +x dist/cli.js"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml}": "prettier --write",
    "*.{ts,js,mjs,cjs}": "eslint --fix"
  },
  "keywords": [
    "search",
    "download",
    "cli",
    "visuales",
    "uclv"
  ],
  "author": "Carlos Daniel Vilaseca Illnait",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlos-err406/visuales-search.git"
  },
  "bugs": {
    "url": "https://github.com/Carlos-err406/visuales-search/issues"
  },
  "homepage": "https://github.com/Carlos-err406/visuales-search#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.50.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cheerio": "^1.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "easydl": "^1.2.0",
    "inquirer": "^13.1.0",
    "p-limit": "^7.2.0"
  }
}
