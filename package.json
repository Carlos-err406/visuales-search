{
  "name": "visuales",
  "version": "2.0.0",
  "description": "Search and download visuales.uclv.cu content from the terminal",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "visuales": "dist/cli.js"
  },
  "type": "module",
  "workspaces": [
    "apps/cli",
    "apps/desktop",
    "apps/sidecar",
    "packages/core"
  ],
  "scripts": {
    "build": "npm run clean && npm run build -w @visuales/core && tsc && node scripts/build-cli.mjs",
    "sidecar:build": "npm run build -w @visuales/core && tsc -p apps/sidecar/tsconfig.json && node scripts/build-sidecar.mjs",
    "sidecar:prepare": "npm run sidecar:build && node scripts/prepare-sidecar.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "rust:build": "npm run sidecar:prepare && cargo build --workspace",
    "rust:test": "npm run sidecar:prepare && cargo test --workspace",
    "desktop:dev": "npm --prefix apps/desktop run tauri dev",
    "desktop:build": "npm --prefix apps/desktop run tauri build",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run build && npm run sidecar:build && node --test \"test/**/*.test.mjs\"",
    "check": "npm run lint && npm test",
    "release:check": "npm run check && npm pack --dry-run --cache .cache/npm",
    "version:check": "node scripts/release-version.mjs",
    "version:sync": "node scripts/release-version.mjs --write",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:signatures": "node scripts/test-update-signatures.mjs",
    "version": "node scripts/release-version.mjs --write --stage",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "prepare": "node scripts/prepare.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml}": "prettier --write",
    "*.{ts,js,mjs,cjs}": "eslint --fix"
  },
  "keywords": [
    "search",
    "download",
    "cli",
    "visuales",
    "uclv"
  ],
  "author": "Carlos Daniel Vilaseca Illnait",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Carlos-err406/visuales-search.git"
  },
  "bugs": {
    "url": "https://github.com/Carlos-err406/visuales-search/issues"
  },
  "homepage": "https://github.com/Carlos-err406/visuales-search#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "1.62.1",
    "prettier": "^3.7.4",
    "smol-toml": "^1.8.0",
    "typescript-eslint": "^8.50.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cheerio": "^1.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "date-fns": "^4.1.0",
    "easydl": "^1.2.0",
    "inquirer": "^13.1.0",
    "p-limit": "^7.2.0",
    "proper-lockfile": "^4.1.2"
  }
}
